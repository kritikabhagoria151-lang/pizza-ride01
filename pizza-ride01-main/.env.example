# ============================================================
# Pizza Ride — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains sensitive secrets.
# ============================================================

# ----- Database -----
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/pizza_ride

# ----- Server -----
# Set automatically by Replit workflows — do not change
PORT=8080

# Node environment: development | production
NODE_ENV=development

# ----- Logging -----
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ----- Session -----
# Strong random string used to sign session cookies
# Generate one: openssl rand -base64 32
SESSION_SECRET=your_strong_random_secret_here
